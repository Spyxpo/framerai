PORT=3001
CORS_ORIGIN=http://localhost:5173

# Logging configuration
# LOG_LEVEL: error, warn, info, or debug (default: info)
# LOG_FORMAT: json or pretty (default: json, use pretty for development)
LOG_LEVEL=info
LOG_FORMAT=json

# Cognition trace forwarding (Issue #164)
# When true, result.trace from the model is included in chat response metadata.
# Off by default: traces may contain recalled memories (user content).
# Set to true only in operator/trusted contexts.
# INCLUDE_TRACE=false
#
# An `x-operator: true` request header also turns the trace on, but only when
# TRUST_PROXY is set, since a client can send that header for itself. Behind an
# untrusted proxy the header is ignored and INCLUDE_TRACE is the only switch.

# Inference bridge. When MODEL_ENABLED=true and MODEL_PATH exists, the backend
# spawns the Python worker (model/serve.py) for real inference; otherwise it
# returns placeholder responses.
MODEL_ENABLED=true
MODEL_PATH=../checkpoints/export/framerai_model.pt
TOKENIZER_PATH=../checkpoints/export/tokenizer
PYTHON_BIN=python3
DEVICE=auto
MODEL_TIMEOUT_MS=180000

# Toolsets the worker may register, comma-separated. Empty (the default) starts
# the worker with no tools at all. "web" adds internet search and page fetch and
# "cli" adds a sandboxed shell; a chat message opts in with settings.tools.
MODEL_TOOLS=

# Only read when MODEL_TOOLS includes cli. Mode "off" refuses every command,
# "allow" runs allowlisted programs unattended inside MODEL_CLI_ROOT.
MODEL_CLI_MODE=off
MODEL_CLI_ROOT=..

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Upload retention. Stored uploads are reclaimed once they are older than
# UPLOAD_TTL_MS, and the oldest are reclaimed early whenever the managed
# buckets (images, audio, documents) together exceed MAX_UPLOAD_BYTES. The
# ceiling is what bounds a burst: the TTL alone still admits rate x TTL.
# Sweeps are triggered by an upload arriving, at most once per
# UPLOAD_SWEEP_INTERVAL_MS. uploads/generated and uploads/videos hold model
# output and are not swept.
UPLOAD_TTL_MS=86400000
MAX_UPLOAD_BYTES=2147483648
UPLOAD_SWEEP_INTERVAL_MS=60000

# Payload limits
JSON_BODY_LIMIT=1mb
MAX_WS_PAYLOAD=1048576

# Rate limiting, per client address, within a fixed window. Set a max to 0 to
# turn that limiter off. GENERATE_RATE_LIMIT_MAX covers the generation routes,
# chat messages, and WebSocket chat frames, which share one set of buckets.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
GENERATE_RATE_LIMIT_MAX=20

# Number of reverse proxies in front of the backend, or false when it is
# exposed directly. Without this every request behind a proxy looks like it
# comes from the proxy and shares a single rate limit bucket.
TRUST_PROXY=false
